name: Flutter kiosk foundation
on:
  push:
    paths: ['frontend/app/**', '.github/workflows/kiosk-flutter.yml']
  pull_request:
    paths: ['frontend/app/**', '.github/workflows/kiosk-flutter.yml']
permissions:
  contents: read
jobs:
  flutter:
    runs-on: ubuntu-latest
    defaults:
      run:
        working-directory: frontend/app
    steps:
      - uses: actions/checkout@v4
      - uses: subosito/flutter-action@v2
        with:
          flutter-version: '3.35.7'
          channel: stable
          cache: true
      - run: flutter pub get
      - run: dart run build_runner build --delete-conflicting-outputs
      - run: flutter analyze
      - run: flutter test --coverage
      - run: flutter build web --release --no-web-resources-cdn --pwa-strategy=none --dart-define-from-file=config/production.json
      - uses: actions/upload-artifact@v4
        with:
          name: kiosk-web-preview
          path: frontend/app/build/web
