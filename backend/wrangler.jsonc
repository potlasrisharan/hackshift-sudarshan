{
  "$schema": "../node_modules/wrangler/config-schema.json",
  "name": "dhaaga-integration",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-17",
  "assets": {
    "directory": "../dist/integration",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": true
  },
  "d1_databases": [{
    "binding": "DB",
    "database_name": "dhaaga-integration",
    "migrations_dir": "../.local/integration-migrations"
  }],
  "vars": { "ENVIRONMENT": "production" }
}
