# Demo accepts synthetic data only. The API defaults to loopback.
PORT=8787
HOST=127.0.0.1
# Providers intentionally disabled; no unverified integration is silently enabled.
AI_ENABLED=false
SARVAM_SPEECH_ENABLED=false
SARVAM_API_KEY=
# Optional local Privacy Node (not connected to the demo API yet)
OLLAMA_BASE_URL=http://127.0.0.1:11434
PRIVACY_NODE_TOKEN=
# New persistent synthetic integration (separate from the legacy demo)
INTEGRATION_PORT=8790
INTEGRATION_DB=.local/integration.sqlite
